<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>group18</groupId>
        <artifactId>group18-project-comp_3607</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>bluej-extension</artifactId>
    <packaging>jar</packaging>

    <name>Group 18 BlueJ Telemetry Extension</name>
    <description>
        The BlueJ adapters (package, compile, invocation and editor listeners, Tools menu, preferences) and the
        installable plugin jar, which bundles telemetry-core, Jackson and OpenPDF.
    </description>

    <properties>
        <!-- BlueJ's own jar, which contains the extensions API. Override with -Dbluej.jar=/path/to/bluej.jar -->
        <bluej.jar>${project.basedir}/../lib/bluej.jar</bluej.jar>
        <plugin.main.class>group18.bluej.BlueJTelemetryExtension</plugin.main.class>
    </properties>

    <dependencies>
        <dependency>
            <groupId>group18</groupId>
            <artifactId>telemetry-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.bluej</groupId>
            <artifactId>bluej</artifactId>
            <version>5</version>
            <scope>system</scope>
            <systemPath>${bluej.jar}</systemPath>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>group18-bluej-telemetry-${project.version}</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${plugin.main.class}</mainClass>
                                    <manifestEntries>
                                        <Implementation-Title>${project.parent.name}</Implementation-Title>
                                        <Implementation-Version>${project.version}</Implementation-Version>
                                    </manifestEntries>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
