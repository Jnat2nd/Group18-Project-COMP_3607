 //It records a finished program run together with a summary of the console output it produced.
public class ExecutionCommand implements TelemetryCommand {

    private final ExecutionEvent run;
    private final String terminalText;
    private final EventSink sink;

    public ExecutionCommand(ExecutionRecord run, String terminalText, ConsoleOutputSummariser summariser, TelemetryEventParser parser, EventSink sink) {
        this.run = run;
        this.terminalText = terminalText;
        this.summariser = summariser;
        this.parser = parser;
        this.sink = sink;
    }

    @Override
    public void execute() {
        sink.publish(parser.parseExecution(run, summariser.summarise(terminalText)));
    }
}
