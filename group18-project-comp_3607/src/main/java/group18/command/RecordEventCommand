package group18.command;

import group18.model.TelemetryEvent;

//to Publish a finished built event
public class RecordEventCommand implements TelemetryCommand {

    private final TelemetryEvent event;
    private final EventSink sink;

    public RecordEventCommand(TelemetryEvent event, EventSink sink) {
        this.event = event;
        this.sink = sink;
    }

    @Override
    public void execute() {
        sink.publish(event);
    }
}
