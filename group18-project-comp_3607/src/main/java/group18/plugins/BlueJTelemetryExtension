
package group18;

import bluej.extensions2.BlueJ;
import bluej.extensions2.Extension;

//Source that helped: https://www.geeksforgeeks.org/java/java-nio-file-paths-class-in-java/
import java.nio.file.Path;
import java.nio.file.Paths;
import java.time.Clock;
import java.time.Duration;

public class BlueJTelemetryExtension extends Extension {

    static final String Student_ID_Property="studentID";
    static Final Duration Sample_Period =Duration.ofSeconds(10);
    static final Duration SHUTDOWN_Timeout =Duration.ofSeconds(20);

    private TelemetryPluginFacade facade;
    private SourceSampler sampler;

    @Override
    public void startup(BlueJ bluej) {

        Clock clock = Clock.systemUTC();
        Path outputDirectory = Paths.get(System.getProperty("user.home"), "bluej telemetry");
        String studentId = bluej.getExtensionPropertyString(Student_ID_Property, SessionInfo.DEFAULT_STUDENT_ID);

        facade = TelemetryPluginFacade.createDefault(outputDirectory, studentId, clock);
        facade.start();

        bluej.addPackageListener(new PackageEventAdapter(facade));
        bluej.addCompileListener(new CompileEventAdapter(facade, clock));
        bluej.addInvocationFinishedListener(new InvocationEventAdapter(facade, new BlueJTerminalReader(), clock));
        bluej.setMenuGenerator(new BlueJToolsMenuBuilder(facade));

        sampler = new SourceSampler(bluej, facade, clock, Sample_Period);
        sampler.start();
    }

    @Override
    public void terminate() {
        if (sampler != null) {sampler.stop();}

        if (facade != null && !facade.shutdown(SHUTDOWN_Timeout)) {
            System.err.println("[telemetry] final export failed; therefore the session will be recovered on next start-up");
        }
    }
    @Override
    public boolean isCompatible() {
        return getExtensionsAPIVersionMajor() >= 3; 

    @Override
    public String getVersion() {
        return "1.1.0";
    }

    @Override
    public String getName() {
        return "COMP3607 Group 18 Telemetry Analytics";
    }

    @Override
    public String getDescription() {
        return "Records project, editor, compilation and execution telemetry and exports JSON and PDF reports.";
    }
}


}
