package group18;

import java.util.Optional;

public class TextInputConsoleSource implements ConsoleTextSource {
    private final TextInputControl control;

    public TextInputConsoleSource(TextInputControl control) {
        this.control = Objects.requireNonNull(control);
    }

    @Override
    public Optional<String> readConsoleText() {
        return Optional.ofNullable(control.getText()).filter(s -> !s.isEmpty());
    }
}